# Plantilla para un backend AISLADO de pruebas. Nunca usar una base con pagos reales.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://llevo:REPLACE_ME@localhost:5432/llevo_internal
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d
INTERNAL_TESTING=true
INTERNAL_TESTER_EMAILS=pasajero@example.com,conductor@example.com
INTERNAL_BOTS_AVAILABLE=true
DIDIT_BYPASS_VERIFICATION=true
CORS_ORIGIN=https://llevo.duckdns.org
EMAIL_AUTH_DELIVERY_MODE=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION_CODE=AR
GOOGLE_MAPS_LANGUAGE_CODE=es-AR
DEMO_RIDE_BOT_APPROVAL_DELAY_MS=8000
DEMO_RIDE_BOT_COMPLETION_DELAY_MS=30000
DEMO_SHIPMENT_BOT_ACCEPT_DELAY_MS=8000
DEMO_SHIPMENT_BOT_PICKUP_DELAY_MS=25000
DEMO_SHIPMENT_BOT_DELIVERY_DELAY_MS=45000
# No agregar MP_ACCESS_TOKEN: los cobros externos están deshabilitados en esta entrega.
