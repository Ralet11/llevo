# Database
# Reemplaza USER y PASSWORD por credenciales reales de tu Postgres local o remoto.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/llevo_db"

# Server
PORT=3001
NODE_ENV=development

# Auth
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d
PHONE_DEFAULT_COUNTRY_CODE=+54
# Google Sign-In: client IDs validos como audiencia del id_token, separados por coma.
# Pega los 3 client IDs de Google Cloud (Web + Android + iOS) que crees en
# https://console.cloud.google.com -> APIs & Services -> Credentials.
GOOGLE_OAUTH_CLIENT_IDS=
# Sign in with Apple: bundle id de la app iOS (audiencia del identity token).
APPLE_BUNDLE_ID=com.llevo.app
EMAIL_AUTH_DELIVERY_MODE=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=LLEVO <onboarding@tu-dominio.com>

# Twilio Verify (OTP por telefono)
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Alternativa para desarrollo local si no usas API Keys:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Didit (verificacion de conductores)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_API_BASE_URL=https://verification.didit.me/v3
DIDIT_BYPASS_VERIFICATION=false
# Fallback si no envias callbackUrl desde la app.
DIDIT_CALLBACK_URL=llevo://driver/verify
# Se obtiene al crear el destino webhook en Didit.
DIDIT_WEBHOOK_SECRET=
# Endpoint publico a registrar en Didit:
# https://tu-backend.com/api/v1/drivers/verification/webhook

# HTTP / CORS
# Se admiten varios orígenes separados por coma. Las apps nativas no envían Origin.
CORS_ORIGIN=http://localhost:3000
HTTP_BODY_LIMIT=1mb

# Payments (Mercado Pago)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
PLATFORM_FEE_PERCENT=12
SHIPMENT_BASE_FEE=1500
SHIPMENT_PRICE_PER_KM=600
SHIPMENT_PRICE_PER_MINUTE=35
SHIPMENT_PRICE_PER_KG=250
SHIPMENT_SIZE_SURCHARGE_SMALL=0
SHIPMENT_SIZE_SURCHARGE_MEDIUM=500
SHIPMENT_SIZE_SURCHARGE_LARGE=1200
SHIPMENT_SIZE_SURCHARGE_BULKY=2500
MP_WEBHOOK_URL=
MP_WEBHOOK_SECRET=

# Demo de envíos para testers. En producción debe permanecer apagado salvo una prueba controlada.
# Solo actúa cuando el remitente autorizado no tiene ningún conductor real compatible.
DEMO_SHIPMENT_BOT_ENABLED=false
# true permite el bot para cualquier usuario; mantener false para limitarlo a testers.
DEMO_SHIPMENT_BOT_ALLOW_ALL_USERS=false
DEMO_SHIPMENT_BOT_ALLOWED_EMAILS=
DEMO_SHIPMENT_BOT_ALLOWED_USER_IDS=
DEMO_SHIPMENT_BOT_ACCEPT_DELAY_MS=8000
DEMO_SHIPMENT_BOT_PICKUP_DELAY_MS=25000
DEMO_SHIPMENT_BOT_DELIVERY_DELAY_MS=45000

# Demo de viajes: por defecto hereda DEMO_SHIPMENT_BOT_ENABLED y su alcance.
DEMO_RIDE_BOT_ENABLED=
DEMO_RIDE_BOT_ALLOW_ALL_USERS=
DEMO_RIDE_BOT_ALLOWED_EMAILS=
DEMO_RIDE_BOT_ALLOWED_USER_IDS=
DEMO_RIDE_BOT_APPROVAL_DELAY_MS=8000
DEMO_RIDE_BOT_PRICE_PER_SEAT=1000
