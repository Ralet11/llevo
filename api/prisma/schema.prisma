generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  appleId       String?  @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  dni           String?  @unique
  isVerified    Boolean  @default(false)
  phoneVerifiedAt DateTime?
  driverVerificationStatus DriverVerificationStatus @default(NOT_STARTED)
  driverVerificationSessionId String? @unique
  driverVerificationUrl String?
  driverVerificationSubmittedAt DateTime?
  driverVerificationCheckedAt DateTime?
  driverVerificationNotes String?
  driverVerificationDecision Json?
  driverVerifiedAt DateTime?
  isActive      Boolean  @default(true)
  rating        Float    @default(0)
  ratingCount   Int      @default(0)
  pushToken     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tripsAsDriver     Trip[]           @relation("DriverTrips")
  passengerRequests TripRequest[]
  packageRequests   PackageRequest[]
  reviewsGiven      Review[]         @relation("ReviewsGiven")
  reviewsReceived   Review[]         @relation("ReviewsReceived")
  payments          Payment[]
  driverRoutes      DriverRoute[]    @relation("DriverRoutes")
  sentShipments     Shipment[]       @relation("SentShipments")
  shipmentJobs      ShipmentJob[]    @relation("DriverJobs")
  emailAuthCodes    EmailAuthCode[]
  daysOff           DriverDayOff[]   @relation("DriverDaysOff")
  vehicles          Vehicle[]        @relation("UserVehicles")
  passengerBookings RideBooking[]    @relation("PassengerBookings")
  travelRequests    TravelRequest[]  @relation("PassengerTravelRequests")
  travelRequestCandidates TravelRequestCandidate[] @relation("TravelRequestCandidateDrivers")
  routeAlerts       RouteAlert[]
}

enum DriverVerificationStatus {
  NOT_STARTED
  PENDING
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DECLINED
  RESUBMITTED
  EXPIRED
  ABANDONED
  KYC_EXPIRED
}

// ─────────────────────────────────────────────
// TRIP
// ─────────────────────────────────────────────

model Trip {
  id                 String     @id @default(cuid())
  driverId           String
  driver             User       @relation("DriverTrips", fields: [driverId], references: [id])

  originCity         String
  destinationCity    String
  originAddress      String?
  destinationAddress String?

  departureDate      DateTime
  estimatedArrival   DateTime?

  availableSeats     Int        @default(0)
  pricePerSeat       Float?

  availableKg        Float      @default(0)
  pricePerKg         Float?

  status             TripStatus @default(OPEN)
  notes              String?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  passengerRequests  TripRequest[]
  packageRequests    PackageRequest[]
  payments           Payment[]
}

enum TripStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// TRIP REQUEST (pasajeros)
// ─────────────────────────────────────────────

model TripRequest {
  id          String        @id @default(cuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id])
  passengerId String
  passenger   User          @relation(fields: [passengerId], references: [id])

  seats       Int           @default(1)
  status      RequestStatus @default(PENDING)
  message     String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment     Payment?
}

// ─────────────────────────────────────────────
// PACKAGE REQUEST (encomiendas)
// ─────────────────────────────────────────────

model PackageRequest {
  id              String        @id @default(cuid())
  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id])
  senderId        String
  sender          User          @relation(fields: [senderId], references: [id])

  description     String
  weightKg        Float
  deliveryAddress String?
  status          RequestStatus @default(PENDING)
  message         String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment         Payment?
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("ReviewsGiven", fields: [fromId], references: [id])
  toId      String
  to        User     @relation("ReviewsReceived", fields: [toId], references: [id])

  rating    Int      // 1 a 5
  comment   String?

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// PAYMENT (escrow)
// ─────────────────────────────────────────────

model Payment {
  id               String        @id @default(cuid())
  amount           Float
  platformFee      Float
  netAmount        Float
  // Valores monetarios canónicos en centavos. Los Float previos se conservan
  // temporalmente por compatibilidad con datos existentes.
  amountCents      Int           @default(0)
  platformFeeCents Int           @default(0)
  netAmountCents   Int           @default(0)
  currency         String        @default("ARS")
  status           PaymentStatus @default(PENDING)

  tripId           String?
  trip             Trip?         @relation(fields: [tripId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])

  tripRequestId    String?       @unique
  tripRequest      TripRequest?  @relation(fields: [tripRequestId], references: [id])

  packageRequestId String?       @unique
  packageRequest   PackageRequest? @relation(fields: [packageRequestId], references: [id])

  shipmentJobId    String?       @unique
  shipmentJob      ShipmentJob?  @relation(fields: [shipmentJobId], references: [id])

  rideBookingId    String?       @unique
  rideBooking      RideBooking?  @relation(fields: [rideBookingId], references: [id])

  externalId       String?
  providerPreferenceId String? @unique
  providerPaymentId String? @unique

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
}

// ─────────────────────────────────────────────
// DRIVER ROUTE (corredor habitual del conductor)
// ─────────────────────────────────────────────

model DriverRoute {
  id                String      @id @default(cuid())
  driverId          String
  driver            User        @relation("DriverRoutes", fields: [driverId], references: [id])

  // INTERCITY: origen -> paradas -> destino, en dias programados.
  // LOCAL: una sola ciudad (origin == destination), isActive = online/offline.
  kind              DriverRouteKind @default(INTERCITY)

  originCity        String
  waypointCities    String[]    @default([])
  destinationCity   String

  daysOfWeek        DayOfWeek[]
  departureTimeFrom String?
  departureTimeTo   String?

  vehicleType       VehicleType
  licensePlate      String?
  vehicleModel      String?
  vehicleColor      String?
  maxWeightKg       Float
  pricePerKg        Float?

  // Pasajeros: una misma ruta puede llevar paquetes y personas si el conductor lo
  // habilita. seatsOffered es cuantos asientos ofrece (<= vehicle.seats).
  vehicleId         String?
  vehicle           Vehicle?    @relation(fields: [vehicleId], references: [id])
  carriesPassengers Boolean     @default(false)
  seatsOffered      Int?
  pricePerSeat      Float?

  isActive          Boolean     @default(true)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  shipmentJobs      ShipmentJob[]
  rideBookings      RideBooking[]
  travelRequestCandidates TravelRequestCandidate[]
  matchedTravelRequests TravelRequest[] @relation("MatchedTravelRequests")
}

// ─────────────────────────────────────────────
// VEHICLE (flota del conductor)
// ─────────────────────────────────────────────

model Vehicle {
  id           String      @id @default(cuid())
  driverId     String
  driver       User        @relation("UserVehicles", fields: [driverId], references: [id])

  type         VehicleType
  licensePlate String?
  model        String?
  color        String?
  // Asientos disponibles para pasajeros (sin contar al conductor).
  seats        Int         @default(4)

  isActive     Boolean     @default(true)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  routes       DriverRoute[]
}

enum DriverRouteKind {
  INTERCITY
  LOCAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum VehicleType {
  MOTO
  AUTO
  CAMIONETA
  CAMION
}

// Dia que el conductor marca como "no disponible" para viajes INTERCITY
// programados (no aplica a LOCAL: eso ya se resuelve con isActive/online).
// date en formato YYYY-MM-DD, mismo formato que ya usa el frontend en dayKey().
model DriverDayOff {
  id        String   @id @default(cuid())
  driverId  String
  driver    User     @relation("DriverDaysOff", fields: [driverId], references: [id])
  date      String

  createdAt DateTime @default(now())

  @@unique([driverId, date])
}

// ─────────────────────────────────────────────
// SHIPMENT (pedido de encomienda del usuario)
// ─────────────────────────────────────────────

model Shipment {
  id                   String         @id @default(cuid())
  senderId             String
  sender               User           @relation("SentShipments", fields: [senderId], references: [id])

  originCity           String
  destinationCity      String
  originAddress        String
  deliveryAddress      String

  weightKg             Float
  packageSize          PackageSize
  preferredDate        DateTime?
  estimatedDistanceKm  Float         @default(0)
  estimatedDurationMin Int           @default(0)

  pickupContactName    String
  pickupContactPhone   String
  recipientDetails     String
  notes                String?

  candidateDriverIds   String[]       @default([])
  lastNotifiedAt       DateTime?
  status               ShipmentStatus @default(SEARCHING)

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  job                  ShipmentJob?
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
  BULKY
}

enum ShipmentStatus {
  SEARCHING
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
  NO_COVERAGE
}

// ─────────────────────────────────────────────
// SHIPMENT JOB (match confirmado conductor-pedido)
// ─────────────────────────────────────────────

model ShipmentJob {
  id          String      @id @default(cuid())
  shipmentId  String      @unique
  shipment    Shipment    @relation(fields: [shipmentId], references: [id])
  driverId    String
  driver      User        @relation("DriverJobs", fields: [driverId], references: [id])
  routeId     String
  route       DriverRoute @relation(fields: [routeId], references: [id])

  status      JobStatus   @default(ACTIVE)
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  // Cotizacion inmutable aceptada por remitente y conductor. Todos los montos
  // son ARS y se copian aqui para que editar una ruta no cambie un envio activo.
  baseFee          Float @default(0)
  distanceFee      Float @default(0)
  timeFee          Float @default(0)
  weightFee        Float @default(0)
  sizeSurcharge    Float @default(0)
  platformFee      Float @default(0)
  quotedTotal      Float @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  payment     Payment?
}

enum JobStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// RIDE BOOKING (pasajero se suma a una ruta en una fecha)
// ─────────────────────────────────────────────

model RideBooking {
  id              String            @id @default(cuid())
  routeId         String
  route           DriverRoute       @relation(fields: [routeId], references: [id])
  passengerId     String
  passenger       User              @relation("PassengerBookings", fields: [passengerId], references: [id])

  // Fecha del viaje en formato YYYY-MM-DD (hora local AR, igual que DriverDayOff).
  // Las rutas son recurrentes, la reserva es para un dia concreto.
  date            String
  seats           Int               @default(1)
  originCity      String
  destinationCity String
  // Snapshot del precio al momento de solicitar (la ruta puede cambiarlo despues).
  pricePerSeat    Float?

  status          RideBookingStatus @default(PENDING)

  // Si la reserva surgió de una intención de viaje, conserva su trazabilidad.
  travelRequestId String?           @unique
  travelRequest   TravelRequest?    @relation(fields: [travelRequestId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payment         Payment?

  @@index([routeId, date])
  @@index([passengerId])
}

enum RideBookingStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

// Intención persistente de un pasajero. Puede nacer sin que exista todavía una
// ruta confirmada y se publica para que un conductor compatible la tome.
model TravelRequest {
  id              String              @id @default(cuid())
  passengerId     String
  passenger       User                @relation("PassengerTravelRequests", fields: [passengerId], references: [id])

  originCity      String
  destinationCity String
  // Fecha local de servicio YYYY-MM-DD (America/Argentina/Buenos_Aires).
  date            String
  seats           Int                 @default(1)

  status          TravelRequestStatus @default(SEARCHING)
  searchDeadline  DateTime
  publishedAt     DateTime?
  matchedAt       DateTime?
  cancelledAt     DateTime?
  expiresAt       DateTime?

  matchedRouteId  String?
  matchedRoute    DriverRoute?        @relation("MatchedTravelRequests", fields: [matchedRouteId], references: [id])
  candidates      TravelRequestCandidate[]
  events          TravelRequestEvent[]
  booking         RideBooking?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([passengerId, status])
  @@index([status, searchDeadline])
  @@index([status, date])
  @@index([matchedRouteId])
}

// Registro auditable de cada conductor/ruta notificado por una solicitud.
model TravelRequestCandidate {
  id              String                      @id @default(cuid())
  travelRequestId String
  travelRequest   TravelRequest               @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  routeId         String
  route           DriverRoute                 @relation(fields: [routeId], references: [id])
  driverId        String
  driver          User                        @relation("TravelRequestCandidateDrivers", fields: [driverId], references: [id])

  status          TravelRequestCandidateStatus @default(NOTIFIED)
  notifiedAt      DateTime                    @default(now())
  respondedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([travelRequestId, routeId])
  @@index([driverId, status])
  @@index([travelRequestId, status])
}

enum TravelRequestStatus {
  SEARCHING
  PUBLISHED
  MATCHED
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum TravelRequestCandidateStatus {
  NOTIFIED
  ACCEPTED
  REJECTED
  EXPIRED
}

// Historial inmutable para soporte, UI y auditoría de una intención de viaje.
model TravelRequestEvent {
  id              String        @id @default(cuid())
  travelRequestId String
  travelRequest   TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  type            TravelRequestEventType
  actorUserId     String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([travelRequestId, createdAt])
}

// Alerta pasiva: no crea una demanda ni contacta conductores. Solo avisa al
// pasajero si posteriormente se publica una ruta que cubre su tramo y fecha.
model RouteAlert {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originCity      String
  destinationCity String
  date            String
  notifiedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, originCity, destinationCity, date])
  @@index([date, cancelledAt])
}

enum TravelRequestEventType {
  CREATED
  CANDIDATES_NOTIFIED
  PUBLISHED
  MATCHED
  CANCELLED
}

model EmailAuthCode {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([email, createdAt(sort: Desc)])
}
